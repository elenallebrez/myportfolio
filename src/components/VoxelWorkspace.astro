<div class="voxel-workspace reveal" data-reveal>
  <button
    class="voxel-workspace__trigger"
    type="button"
    data-workspace-trigger
    aria-label="Enter Elena's digital workspace"
    aria-describedby="workspace-hint"
  >
    <picture>
      <source srcset="/img/yo-escritorio.webp" type="image/webp" />
      <img
        src="/img/yo-escritorio.png"
        alt=""
        width="1280"
        height="1280"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </picture>
    <span class="voxel-workspace__hint" id="workspace-hint">
      <span aria-hidden="true"></span>
      Enter my workspace
    </span>
  </button>
</div>
