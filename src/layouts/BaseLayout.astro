---
import { ClientRouter } from 'astro:transitions';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import CommandPalette from '@components/CommandPalette.astro';
import { navigation, projects, site } from '@data/content.js';
import '@fontsource-variable/newsreader';
import '@fontsource-variable/manrope';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';

const {
  title = site.name,
  description = site.introduction,
  image = null,
} = Astro.props;

const pageTitle = title === site.name ? title : `${title} — ${site.name}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const socialImage = image && Astro.site ? new URL(image, Astro.site) : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f1eb" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header currentPath={Astro.url.pathname} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <CommandPalette items={navigation} projects={projects} />
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
