---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectFeature from '@components/ProjectFeature.astro';
import SectionHeader from '@components/SectionHeader.astro';
import { cv, featuredProjects, site } from '@data/content.js';
---

<BaseLayout>
  <section class="hero shell">
    <div class="hero__copy">
      <p class="eyebrow reveal" data-reveal>{site.role}</p>
      <h1 class="hero__title" transition:name="page-title">
        <span>Elena</span>
        <span>Fernández-</span>
        <span>Llebrez</span>
      </h1>
      <div class="hero__positioning reveal" data-reveal>
        <p>{site.introduction}</p>
        <div class="hero__actions">
          <a class="button button--primary" href="/projects/">View projects <span aria-hidden="true">→</span></a>
          <a class="text-link" href={`mailto:${site.contact.email}`}>Email me</a>
        </div>
      </div>
    </div>
    <p class="hero__scroll" aria-hidden="true"><span></span> Scroll to explore</p>
  </section>

  <section class="section shell" aria-labelledby="selected-work">
    <SectionHeader index="01" label="Selected work" title="Projects" id="selected-work" link="/projects/" linkLabel="All projects" />
    <div class="project-stack">
      {featuredProjects.map((project, index) => <ProjectFeature project={project} position={index} />)}
    </div>
  </section>

  <section class="section shell" aria-labelledby="experience-heading">
    <SectionHeader index="02" label="Experience" title="Experience" id="experience-heading" link="/about/" linkLabel="About me" />
    <div class="timeline">
      {cv.experiencia.map((experience) => (
        <article class="timeline-entry reveal" data-reveal>
          <p class="timeline-entry__date">{experience.fecha}</p>
          <div>
            <h3>{experience.nombre} <span>— {experience.ubicacion}</span></h3>
            <p class="timeline-entry__role">{experience.puesto}</p>
            <p>{experience.descripcion}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="contact-cta shell reveal" data-reveal aria-labelledby="contact-cta-title">
    <p class="eyebrow">03 / Contact</p>
    <h2 id="contact-cta-title">Contact</h2>
    <a class="button button--primary" href="/contact/">Contact me <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
