---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeader from '@components/SectionHeader.astro';
import { cv, site } from '@data/content.js';
---

<BaseLayout title={cv.titulo} description={cv.descripcion[0]}>
  <section class="page-hero shell">
    <p class="eyebrow reveal" data-reveal>About / Experience</p>
    <h1 transition:name="page-title">About<br />me.</h1>
    <div class="page-hero__intro reveal" data-reveal>
      {cv.descripcion.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="section shell" aria-labelledby="about-experience">
    <SectionHeader index="01" label="Experience" title="Experience" id="about-experience" />
    <div class="experience-list">
      {cv.experiencia.map((experience, index) => (
        <article class="experience-entry reveal" data-reveal>
          <p class="experience-entry__index">{String(index + 1).padStart(2, '0')}</p>
          <p class="experience-entry__date">{experience.fecha}</p>
          <div class="experience-entry__main">
            <h3>{experience.nombre}</h3>
            <p class="experience-entry__place">{experience.ubicacion}</p>
            <p class="experience-entry__role">{experience.puesto}</p>
            <p>{experience.descripcion}</p>
            <ul>
              {experience.responsabilidades.map((responsibility) => <li>{responsibility}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section shell" aria-labelledby="education-heading">
    <SectionHeader index="02" label="Education" title="Education" id="education-heading" />
    <div class="education-list">
      {cv.educacion.map((education) => (
        <article class="education-entry reveal" data-reveal>
          <p>{education.fecha}</p>
          <div>
            <h3>{education.titulo}</h3>
            <p class="education-entry__school">{education.centro}</p>
            <p>{education.descripcion}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section shell" aria-labelledby="skills-heading">
    <SectionHeader index="03" label="Skills" title="Skills" id="skills-heading" />
    <div class="skills-layout">
      <div class="skill-group reveal" data-reveal>
        <h3>Hard Skills</h3>
        <ul>{cv.habilidades.hard_skills.map((skill) => <li>{skill}</li>)}</ul>
      </div>
      <div class="skill-group reveal" data-reveal>
        <h3>Soft Skills</h3>
        <ul>{cv.habilidades.soft_skills.map((skill) => <li>{skill}</li>)}</ul>
      </div>
      <div class="skill-group skill-group--languages reveal" data-reveal>
        <h3>Languages</h3>
        <ul>{cv.habilidades.idiomas.map((language) => <li>{language}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="contact-cta shell reveal" data-reveal>
    <p class="eyebrow">Contact</p>
    <h2>Contact</h2>
    <div class="inline-actions">
      <a class="button button--primary" href="/contact/">Get in touch <span aria-hidden="true">→</span></a>
      <a class="text-link" href={site.contact.linkedin} target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
