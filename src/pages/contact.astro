---
import BaseLayout from '@layouts/BaseLayout.astro';
import ContactForm from '@components/ContactForm.astro';
import { site } from '@data/content.js';
---

<BaseLayout title="Contact" description={`Contact ${site.name}.`}>
  <section class="contact-page shell">
    <div class="contact-page__intro">
      <p class="eyebrow reveal" data-reveal>Contact / Start a conversation</p>
      <h1 transition:name="page-title">Contact.</h1>
      <p class="reveal" data-reveal><a class="text-link" href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p>
      <div class="contact-page__links reveal" data-reveal>
        <a href={site.contact.github} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        <a href={site.contact.linkedin} target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="contact-page__form reveal" data-reveal>
      <ContactForm />
    </div>
  </section>
</BaseLayout>
